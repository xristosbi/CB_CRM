NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by /api/webhook/facebook-leads to write leads without a
# logged-in user session. Supabase Dashboard → Project Settings → API →
# service_role secret. NEVER prefix this with NEXT_PUBLIC_ or expose it to
# the browser: it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Facebook Lead Ads webhook (see README "Facebook Lead Ads webhook" section)
FB_VERIFY_TOKEN=choose-a-random-string
FB_PAGE_ACCESS_TOKEN=your-page-access-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
